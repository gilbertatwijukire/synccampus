# Export these (or put them in your hosting dashboard). SQLite is used if DATABASE_URL is not set.
DATABASE_URL=sqlite:///./saagi.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://saagi:password@localhost:5432/saagi
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_CODE_PEPPER=change-me-too
TOKEN_MINUTES=480
